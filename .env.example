# 复制为 .env 后再填写。不要提交包含真实密钥的 .env。
COMPOSE_PROJECT_NAME=ydisks-xianyu-helper

# PostgreSQL 17
POSTGRES_IMAGE=postgres:17-trixie
POSTGRES_DB=xianyu
POSTGRES_USER=xianyu
POSTGRES_PASSWORD=请替换为高强度数据库密码
# 密码含有特殊字符时，必须先进行 URL 编码。
DATABASE_URL=postgres://xianyu:请替换为URL编码后的数据库密码@postgres:5432/xianyu?sslmode=disable

# 应用：默认 compose.yml 仅拉取 GHCR 镜像，不会在服务器上构建源码。
XIANYU_IMAGE=ghcr.io/christ9038/ydisks-xianyu-helper:latest
XIANYU_DATA_KEY=请替换为稳定且足够长的随机密钥
XIANYU_BIND_ADDRESS=0.0.0.0
XIANYU_HTTP_PORT=59188
XIANYU_UPLOAD_DIR=/app/data/uploads
TZ=Asia/Shanghai
LOG_LEVEL=info
LOG_FORMAT=json
BROWSER_HEADLESS=true

# 出站发送闸门：对每个账号的自动回复、发货消息与商品卡片统一施加节奏与额度。
# 未设置的项使用内置默认值；把间隔与抖动都设为 0 可完全关闭闸门。
# XIANYU_SEND_MIN_INTERVAL_MS：两次出站发送之间的基础最小间隔（毫秒），默认 1000。
# XIANYU_SEND_JITTER_MS：叠加在最小间隔之上的随机抖动上限（毫秒），默认 1000。
# XIANYU_SEND_DAILY_LIMIT：单个账号每个自然日的发送条数上限，0 表示不限制（默认不限制）。
# XIANYU_SEND_QUIET_HOURS：静默时段「起始小时-结束小时」（本地时间，可跨午夜，如 23-7）；留空表示不启用。
# XIANYU_GLOBAL_SEND_DAILY_LIMIT：全部账号合计的每日发送条数上限，0 表示不限制（默认不限制）；计数按自然日持久化，重启不清零。
#XIANYU_SEND_MIN_INTERVAL_MS=1000
#XIANYU_SEND_JITTER_MS=1000
#XIANYU_SEND_DAILY_LIMIT=0
#XIANYU_SEND_QUIET_HOURS=
#XIANYU_GLOBAL_SEND_DAILY_LIMIT=0

# 进程级心跳：让宿主（Docker healthcheck / systemd / 运维脚本）判断「进程还活着吗」。
# 心跳只写自有数据库，绝不发起任何闲鱼平台请求（不发消息、不调 mtop、不刷新 cookie、不重连）。
# XIANYU_HEARTBEAT_INTERVAL_SECONDS：心跳写周期（秒），默认 30；设为 0 关闭；非法值回落默认。
#XIANYU_HEARTBEAT_INTERVAL_SECONDS=30

# 首次 docker compose up -d 时自动创建 admin；后续重启不会重置密码。
XIANYU_ADMIN_PASSWORD=请替换为管理员密码
