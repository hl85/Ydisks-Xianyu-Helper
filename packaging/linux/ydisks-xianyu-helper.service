[Unit]
Description=Ydisks Xianyu Helper
After=network-online.target
Wants=network-online.target
# 连续失败重启次数上限：阻止「崩溃→重启→重新申请登录凭证→触发风控」的正反馈无限放大。
# 180 秒窗口内重启超过 5 次后单元进入 failed 状态，需要人工介入而不是继续重试。
StartLimitIntervalSec=180
StartLimitBurst=5

[Service]
Type=simple
User=ydisks-xianyu
Group=ydisks-xianyu
WorkingDirectory=/var/lib/ydisks-xianyu-helper
EnvironmentFile=-/etc/ydisks-xianyu-helper/config.env
Environment=XIANYU_LOG_DIR=/var/log/ydisks-xianyu-helper
ExecStart=/opt/ydisks-xianyu-helper/xianyu-server -addr 127.0.0.1:59188 -workdir /var/lib/ydisks-xianyu-helper -data-key-file /var/lib/ydisks-xianyu-helper/data-key -playwright-runtime-root /opt/ydisks-xianyu-helper/playwright-runtime
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
